{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "redirects": [
    { "source": "/", "destination": "/client/", "permanent": false }
  ],
  "headers": [
    { "source": "/client/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] },
    { "source": "/creator/(.*)", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }] }
  ]
}
